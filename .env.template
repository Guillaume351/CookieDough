HIBERNATE_CONNECTION_DRIVER_CLASS=org.postgresql.Driver
HIBERNATE_CONNECTION_URL=jdbc:postgresql://localhost:5432/yourdatabase
HIBERNATE_CONNECTION_USERNAME=yourusername
HIBERNATE_CONNECTION_PASSWORD=yourpassword
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
HIBERNATE_SHOW_SQL=true
HIBERNATE_HBM2DDL_AUTO=validate

# Shared with the mobile API. Generate at least 32 random characters and keep
# the value stable; plaintext player-link codes are never stored.
MOBILE_LINK_PEPPER=

# Secret-free runtime snapshot consumed by the private update monitor. The
# parent directory is mounted read-only into that service; never mount plugins/.
COOKIEBUILD_RUNTIME_VERSIONS_FILE=/data/update-monitor/installed-versions.json

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Discord Webhook for New Players
DISCORD_NEW_PLAYER_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord Webhook for Player Status (Join/Left)
DISCORD_PLAYER_STATUS_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
